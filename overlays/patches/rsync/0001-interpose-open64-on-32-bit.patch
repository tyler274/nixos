+/* 32-bit glibc with _FILE_OFFSET_BITS=64 calls open64/openat64/fstatat64.
+ * Those are distinct symbols from open/openat/fstatat, so a hook that only
+ * interposes the latter never sees the receiver's O_CREAT and the positive
+ * control fails. On LP64 the *64 names are aliases of the plain ones. */
+#if !defined(__LP64__)
+int open64(const char *path, int flags, ...) __attribute__((alias("open")));
+int openat64(int dfd, const char *path, int flags, ...) __attribute__((alias("openat")));
+
+int fstatat64(int dfd, const char *path, struct stat64 *st, int flags)
+{
+    static int (*real_fstatat64)(int, const char *, struct stat64 *, int);
+    int rc, saved_errno;
+
+    hook_resolve();
+    if (!real_fstatat64)
+        real_fstatat64 = dlsym(RTLD_NEXT, "fstatat64");
+    if (!real_fstatat64) {
+        errno = ENOSYS;
+        return -1;
+    }
+    rc = real_fstatat64(dfd, path, st, flags);
+    saved_errno = errno;
+    model_foreign_owner(rc, path, st->st_mode, &st->st_uid);
+    errno = saved_errno;
+    return rc;
+}
+#endif
+
 __attribute__((constructor)) static void hook_loaded(void)
