+def measured_len(value: object) -> int | None:
+    """Return a container's length, or None if it has no length.
+
+    ``len()`` converts the result to a C ``Py_ssize_t``. A length that does
+    not fit (``range(2**40)`` on 32-bit CPython) raises OverflowError before
+    the capacity check can see the count. The Python ``__len__`` still
+    returns that int, so the check can reject it as excessive capacity.
+    """
+    try:
+        return len(value)
+    except TypeError:
+        return None
+    except OverflowError:
+        try:
+            return value.__len__()  # type: ignore[attr-defined]
+        except (AttributeError, TypeError, OverflowError):
+            raise EvalError("excessive capacity requested: index-sized integer") from None
+
+
